#http {
#    include       /etc/nginx/mime.types;
#    default_type  application/octet-stream;

    # Tiles live in a subdirectory. The cache loader deletes unknown files in the
    # cache path, so the stamp file of 05-invalidate-cache.sh must stay outside.
    # Entries stay valid until the data changes (the startup script clears the cache).
    proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tile_cache:512m
                     max_size=${CACHE_MAX_SIZE} min_free=${CACHE_MIN_FREE}
                     inactive=${CACHE_INACTIVE} use_temp_path=off;

    proxy_connect_timeout       300;
    proxy_send_timeout          300;
    proxy_read_timeout          300;
    send_timeout                300;

    server_tokens off;

    server {
        listen 8081 default_server;
        server_name _;

        # Tile cache proxy for custom styles
        location ~ ^/styles/([a-zA-Z0-9-_]+)/([0-9]+)/([0-9]+)/([0-9]+)(@[23]x)?\.(png|webp)$ {
            set $style $1;
            set $z $2;
            set $x $3;
            set $y $4;
            set $scale $5;  # Can be empty, @2x, or @3x
            set $format $6; # png or webp
            
            # Set default scale if empty
            if ($scale = "") {
                set $scale "@1x";
            }

            # Proxy configuration with caching
            proxy_cache tile_cache;
            proxy_cache_key "$style:$scale:$z:$x:$y:$format";
            # Cache only 200. TileServer GL returns 404 while it loads, and an error
            # in the cache would stay after a restart without a data change.
            proxy_cache_valid 200 365d;
            proxy_cache_methods GET HEAD;

            proxy_cache_lock on;
            proxy_cache_lock_timeout 5s;
            proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
            # Cache duration is set here only, never by upstream headers.
            proxy_ignore_headers Cache-Control Expires;
            proxy_hide_header Cache-Control;
            # Last-Modified is the render time and changes after the cache is cleared.
            # nginx sends 304 only if If-Modified-Since also matches, so revalidate with the ETag only.
            proxy_hide_header Last-Modified;
            # Client caching: 1 day fresh, then revalidate in the background with the ETag
            add_header Cache-Control "max-age=86400, stale-while-revalidate=604800";
            add_header X-Cache-Status $upstream_cache_status always;
            proxy_hide_header Access-Control-Allow-Origin;
            add_header 'Access-Control-Allow-Origin' '*' always;
            proxy_set_header Accept-Encoding "";  # disable compression
            
            proxy_set_header Host $host;
            proxy_pass http://${TILESERVER_APP};
        }

        location = /favicon.ico {
            return 404;
        }

        # Reject all other requests
        location / {
            return 404;
        }
    }
